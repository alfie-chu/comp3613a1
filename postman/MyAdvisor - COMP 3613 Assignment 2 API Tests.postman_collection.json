      "name": "01 Student login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Student login succeeds (200)', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Correct account authenticated', () => pm.expect(data.username).to.eql(pm.collectionVariables.get('student_username')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{student_username}}\",\n  \"password\": \"{{student_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Sets an HTTP-only access_token cookie automatically in the Postman cookie jar."
      },
      "response": []
    },
    {
      "name": "02 Choose available course",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test('Available course lookup succeeds (200)', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('An uncompleted course is available', () => pm.expect(data.courses.length).to.be.above(0));",
              "pm.test('Academic year is available', () => pm.expect(data.academic_years.length).to.be.above(0));",
              "if (data.courses.length && data.academic_years.length) {",
              "    pm.collectionVariables.set('course_id', data.courses[0].id);",
              "    pm.collectionVariables.set('course_code', data.courses[0].course_code);",
              "    pm.collectionVariables.set('academic_year', data.academic_years[0]);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/degree/available-courses",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "degree",
            "available-courses"
          ]
        },
        "description": "Requires a student profile with an uncompleted programme course."
      },
      "response": []
